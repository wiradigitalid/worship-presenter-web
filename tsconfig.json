{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./spa/src/shims/next-link.tsx"],
      "next/navigation": ["./spa/src/shims/next-navigation.ts"],
      "next/headers": ["./spa/src/shims/next-headers.ts"],
      "server-only": ["./spa/src/shims/server-only.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "spa/dist"]
}
